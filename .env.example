# 监听地址与端口
HOST=0.0.0.0
PORT=3000

# 对外访问地址。启动器与 Yggdrasil 材质 URL 依赖它，必须是玩家可访问的地址。
BASE_URL=http://localhost:3000

# 数据与插件目录
DATA_DIR=data
PLUGINS_DIR=plugins

# 位于 Nginx / Caddy 之后时设为 1，读取 X-Forwarded-For
TRUST_PROXY=0

# 首次启动时创建的管理员（已有管理员时不会覆盖）
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=swustmc2026

# 雪花 ID 配置，多实例部署时需保证组合唯一
SNOWFLAKE_DATA_CENTER_ID=1
SNOWFLAKE_MACHINE_ID=1
